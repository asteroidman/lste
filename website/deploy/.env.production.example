# 罗森塔尔 · 网页版 · 生产环境变量（复制为 website/.env）
# 宝塔部署时必填：SESSION_SECRET、DB_PASSWORD、COOKIE_SECURE（有 HTTPS 时 true）

NODE_ENV=production

# Node 监听（Nginx 反代到这里）
PORT=3000
HOST=127.0.0.1

# 会话密钥：换成一长串随机字符（可用 openssl rand -hex 32 生成）
SESSION_SECRET=please-change-me-to-a-long-random-string

# 密码哈希强度（线上 10）
BCRYPT_ROUNDS=10

# 走 HTTPS（宝塔申请证书后）设为 true；纯 HTTP/IP 调试时保持 false，否则登录态发不出去
COOKIE_SECURE=true

# MySQL 8.0.48（宝塔「数据库」里创建）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rosenthal
DB_PASSWORD=
DB_NAME=rosenthal

# 赞助收款码（换成你的图片，放到 public/assets/ 下）
SPONSOR_QR=/assets/pay.svg
