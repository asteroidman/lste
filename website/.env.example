# 罗森塔尔 · 网页版环境变量
# 复制为 .env 并按宝塔里的实际值填写。
# 不填 DB_* 时，服务会用「内存数据源」启动（进程重启即清空，仅本地开发用）。

PORT=3000

# 会话密钥：务必改成一长串随机字符
SESSION_SECRET=change-me-to-a-long-random-string

# 密码哈希强度（越大越慢）。本地/测试可设 4，线上用 10。
BCRYPT_ROUNDS=10

# MySQL（在宝塔「数据库」里建库后填写）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=rosenthal
DB_PASSWORD=
DB_NAME=rosenthal
