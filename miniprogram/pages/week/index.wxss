/* 罗森塔尔 · pages/week/index.wxss（周复盘 + 周报） */

/* 5 步进度 */
.steps{ display: flex; gap: 10rpx; margin-bottom: var(--sp-4); }
.steps__i{
  flex: 1; height: 10rpx; border-radius: var(--r-pill);
  background: var(--paper-lo);
}
.steps__i.on{ background: var(--amber); }

/* 这一周 */
.w__grid{ display: flex; gap: 8rpx; }
.w__d{
  flex: 1; text-align: center;
  background: var(--paper-lo);
  border-radius: var(--r-sm);
  padding: var(--sp-2) 0;
}
.w__d--today{ border: 2rpx solid var(--amber); }
.w__wd{ font-size: 20rpx; color: var(--ink-3); }
.w__sc{ font-family: var(--f-num); font-size: 36rpx; color: var(--amber); }
.w__md{ font-size: 18rpx; color: var(--ink-3); }

.w__row{ display: flex; align-items: center; gap: var(--sp-2); margin-top: var(--sp-3); }
.w__k{ width: 120rpx; font-size: 24rpx; color: var(--ink-2); }
.w__bar{ flex: 1; }
.w__v{ width: 60rpx; text-align: right; font-family: var(--f-num); font-size: 26rpx; }

/* 向导问题与选项 */
.qn{
  font-family: var(--f-display);
  font-size: 36rpx; font-weight: 600; letter-spacing: .02em;
  line-height: 1.6;
}
.qh{ color: var(--ink-2); font-size: 23rpx; line-height: 1.7; margin-top: 6rpx; }

.pick{ display: flex; flex-wrap: wrap; gap: var(--sp-2); margin-top: var(--sp-3); }
.pick__i{
  flex: 1 1 46%;
  padding: var(--sp-3);
  border: 2rpx solid var(--line);
  border-radius: var(--r-sm);
  background: var(--paper-hi);
}
.pick__i.on{ border-color: var(--amber); background: var(--amber-soft); }
.pick__t{ display: block; font-size: 26rpx; line-height: 1.5; }
.pick__m{ display: block; font-size: 20rpx; color: var(--ink-3); margin-top: 4rpx; }

/* 目标太大时的拆小建议 */
.wordwarn{
  padding: var(--sp-3);
  border-radius: var(--r-sm);
  border: 2rpx dashed rgba(217,122,61,.5);
  background: rgba(217,122,61,.08);
  color: #8C4315;
  font-size: 23rpx;
  line-height: 1.7;
}
.wordwarn__row{ display: flex; flex-direction: column; gap: 8rpx; margin-top: var(--sp-2); }
.linkbtn{ color: var(--amber); text-decoration: underline; }

/* 向导底部导航 */
.wiz{
  display: flex; align-items: center; gap: var(--sp-3);
  margin-bottom: var(--sp-4);
}
.wiz__next{ flex: 1; }

/* 周报 */
.report{ padding: var(--sp-5); }
.report__k{
  font-size: 21rpx; letter-spacing: .18em; color: var(--ink-3);
  text-transform: uppercase;
}
.report__t{
  font-family: var(--f-display);
  font-size: 44rpx; font-weight: 600; letter-spacing: .02em;
  margin-top: 6rpx;
}
.report__hl{ display: flex; margin-top: var(--sp-4); }
.report__c{ flex: 1; text-align: center; }
.report__n{ display: block; font-family: var(--f-num); font-size: 48rpx; color: var(--amber); }
.report__l{ display: block; font-size: 20rpx; color: var(--ink-3); margin-top: 2rpx; }

.report__line{
  margin-top: var(--sp-4);
  padding-top: var(--sp-3);
  border-top: 2rpx solid var(--line);
}
.report__b{ display: block; font-size: 25rpx; font-weight: 600; margin-bottom: 8rpx; }
.report__item{ font-size: 25rpx; line-height: 1.75; color: var(--ink-2); }
.report__btn{ flex: 1; }
