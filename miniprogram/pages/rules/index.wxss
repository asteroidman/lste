/* 罗森塔尔 · pages/rules/index.wxss（我的规则） */
.tally{ display: flex; gap: var(--sp-2); }
.tally > view{
  flex: 1; text-align: center;
  padding: var(--sp-2) 0;
  border-radius: var(--r-sm);
  background: var(--paper-lo);
}
.tally > view.on{ background: var(--amber-soft); }
.tally__n{ display: block; font-family: var(--f-num); font-size: 40rpx; }
.tally__l{ font-size: 20rpx; color: var(--ink-2); }
.tally > view.on .tally__l{ color: #8C4315; }

.items{ display: flex; flex-direction: column; gap: var(--sp-2); }
.rule{ display: flex; align-items: center; gap: var(--sp-2); }
.rule__b{ flex: 1; min-width: 0; }
.rule__n{ display: block; font-size: 26rpx; }
.rule__m{ display: block; font-size: 21rpx; color: var(--ink-3); margin-top: 2rpx; }
.rule__btn{
  flex: none;
  min-width: 76rpx; text-align: center;
  padding: 12rpx 0;
  border-radius: var(--r-pill);
  border: 2rpx solid var(--line-2);
  color: var(--ink-2);
  font-size: 22rpx;
}
.rule__btn--warn{ border-color: rgba(217,122,61,.45); color: #A85624; }

.rules-print{ display: flex; gap: var(--sp-2); }
.rules-print > button{ flex: 1; }

.rules-rewards{ display: flex; flex-direction: column; gap: var(--sp-3); }
.rw{ display: flex; align-items: center; gap: var(--sp-3); }
.rw__c{
  flex: none; width: 84rpx; text-align: center;
  font-family: var(--f-num); font-size: 32rpx; color: var(--amber);
  background: var(--paper-lo); border-radius: var(--r-sm); padding: 8rpx 0;
}
.rw__b{ flex: 1; min-width: 0; }
.rw__ops{ display: flex; gap: 8rpx; }
.rw__t{ display: block; font-size: 26rpx; }
.rw__m{ display: block; font-size: 21rpx; color: var(--ink-3); margin-top: 2rpx; }
