/* 罗森塔尔 · pages/shop/index.wxss（兑换） */
.wallet{
  display: flex; gap: var(--sp-3);
  background: var(--paper-hi);
  border: 2rpx solid var(--line);
  border-radius: var(--r-md);
  padding: var(--sp-4);
  box-shadow: var(--sh-1);
  margin-bottom: var(--sp-4);
}
.wallet__c{ flex: 1; }
.wallet__n{ font-family: var(--f-num); font-size: 56rpx; color: var(--amber); line-height: 1.15; }
.wallet__l{ font-size: 21rpx; color: var(--ink-3); margin-top: 2rpx; }

.shop__h{ margin: 0 0 var(--sp-3) var(--sp-1); }

.reward--lock{ opacity: .72; }
.reward__cost{ font-family: var(--f-num); font-size: 34rpx; color: var(--amber); }
.reward__t{
  font-size: 29rpx; font-weight: 500; margin: var(--sp-2) 0 4rpx;
  font-family: var(--f-display); letter-spacing: .01em;
}
.reward__lack{ color: var(--ink-3); font-size: 23rpx; }

.coupon{
  display: flex; align-items: center; gap: var(--sp-3);
  background: var(--paper-hi);
  border: 2rpx solid var(--line);
  border-left: 8rpx solid var(--amber);
  border-radius: var(--r-md);
  padding: var(--sp-4);
  margin-bottom: var(--sp-3);
}
.coupon--used{ border-left-color: var(--ink-3); opacity: .6; }
.coupon--exp{ border-left-color: var(--ink-3); opacity: .7; }
.coupon__l{ flex: 1; min-width: 0; }
.coupon__code{
  font-family: var(--f-num); font-size: 32rpx; letter-spacing: .08em; color: var(--amber);
}
.coupon--used .coupon__code, .coupon--exp .coupon__code{ color: var(--ink-3); }
.coupon__t{ font-size: 26rpx; margin-top: 4rpx; }
.coupon__m{ font-size: 21rpx; color: var(--ink-3); margin-top: 4rpx; }
.coupon__r{ flex: none; text-align: right; }
