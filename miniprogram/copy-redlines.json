{
  "description": "面向孩子的文案红线清单（供 _smoke_s1.js 的 [F] 段使用）。这份文件是**声明**：所有豁免都必须写明理由与证据，测试会逐条验证证据仍然成立。",
  "note": "扫描范围只含 pages / components 下面向孩子的文案（静态 UI 文案 + 行为项名称 + 肯定句）。utils 里的引擎数据不在此列，由 [C] 段在真实引擎上验证。",

  "bannedWords": [
    "你真聪明", "真聪明", "真乖", "真棒", "就是懒", "粗心", "不自律",
    "你怎么又这样", "别人都能做到", "你为什么不行", "退步", "失败", "笨"
  ],

  "redLines": {
    "比较 / 排名": ["别人", "排名", "排行", "比较", "比不上", "你看看人家", "同龄"],
    "监视语气": ["监视", "查岗", "监控", "盯着", "汇报给我"],
    "羞辱性提醒": ["你怎么还没", "又没做", "第几次了", "再这样下去"]
  },

  "negations": ["不是", "没有", "不排", "不比", "不会", "不要", "别", "不必", "不能"],

  "exemptions": [
    {
      "rule": "bannedWords",
      "word": "失败",
      "in": "pages/growth",
      "reason": "这句在**否定**「失败」这个说法：热力图的空白代表那天在休息，不是失败。",
      "evidence": "不是失败"
    },
    {
      "rule": "redLines.比较 / 排名",
      "word": "别人",
      "in": "pages/growth",
      "reason": "在**否认**比较：这一页没有排名、没有「别人家的孩子」。",
      "evidence": "没有排名"
    },
    {
      "rule": "redLines.比较 / 排名",
      "word": "排名",
      "in": "pages/growth",
      "reason": "同上，声明「没有排名」。",
      "evidence": "没有排名"
    },
    {
      "rule": "redLines.比较 / 排名",
      "word": "别人",
      "in": "pages/parent",
      "reason": "家长端声明「没有和别人的比较」，是能力边界说明。",
      "evidence": "和别人的比较"
    },
    {
      "rule": "redLines.比较 / 排名",
      "word": "比较",
      "in": "pages/parent",
      "reason": "家长端的能力边界说明：这一页没有「她没做」的清单，也没有和别人的比较。",
      "evidence": "和别人的比较"
    },
    {
      "rule": "redLines.比较 / 排名",
      "word": "排名",
      "in": "pages/week",
      "reason": "周复盘页声明「这里不排名、不比较」，只让她自己看见力气花在哪。",
      "evidence": "不排名"
    },
    {
      "rule": "redLines.比较 / 排名",
      "word": "比较",
      "in": "pages/week",
      "reason": "同一句的否定式：明确写出「不排名、不比较」，属于对红线的声明而非触犯。",
      "evidence": "不排名、不比较"
    }
  ]
}
