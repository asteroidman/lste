<!-- 得分环：Canvas 2D（移植指南 §四 方案 1）
     数字用衬线体压在心位，canvas 只负责环本身。
     尺寸用 px：canvas 是原生组件，不认 rpx（页面已按 750/视口宽 折算出 px 值）。 -->
<view class="ring" style="width:{{size}}px;height:{{size}}px">
  <canvas wx:if="{{ready}}" type="2d" id="ringCanvas" class="ring__cv"
          style="width:{{size}}px;height:{{size}}px"></canvas>
  <view wx:else class="ring__fallback" style="border-width:{{borderPx}}px"></view>
  <view class="ring__c">
    <view class="ring__n">{{score}}<text class="ring__m">/{{cap}}</text></view>
    <view class="ring__l">今日已得</view>
  </view>
</view>
